.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;max-width:900px;margin:auto}
.item{background:#252525;padding:25px 10px;border:1px solid #555;border-radius:7px;font-weight:bold}
